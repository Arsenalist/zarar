---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { fmtDate } from '../site';
interface Props { title: string; date: Date; back: { href: string; label: string } }
const { title, date, back } = Astro.props;
---
<Base title={title}>
  <div class="cols">
    <article>
      <h1>{title}</h1>
      <time class="date" datetime={date.toISOString()}>{fmtDate(date)}</time>
      <div class="prose" style="margin-top:2.5rem"><slot /></div>
      <p style="margin-top:3rem"><a class="btn" href={back.href}>{back.label}</a></p>
    </article>
    <Sidebar />
  </div>
</Base>
