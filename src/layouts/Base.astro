---
import '../styles/global.css';
import { NAV, EMAIL } from '../site';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = 'Zarar Siddiqi: engineering leader and consultant. AI adoption for engineering teams, AI integration projects, and delivery you can measure.', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · Zarar Siddiqi` : 'Zarar Siddiqi';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={new URL(path, Astro.site)} />}
    <meta name="theme-color" content="#fbf6ea" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Zarar's blog" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="Zarar's notes" href="/notes/feed.xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div>
          <p class="crumbs"><a href="/">zarar.dev</a><span class="sep" aria-hidden="true"></span><a href="https://bitbytebit.substack.com/">Bit Byte Bit</a></p>
          {!noindex && (
            <nav class="nav" aria-label="Main">
              {NAV.map(({ href, label }) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
            </nav>
          )}
        </div>
        <a class="blob" href="/" aria-label="Home"><span>Zarar<small>Siddiqi</small></span></a>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} Zarar Siddiqi · Toronto</p>
        {!noindex && (
          <ul>
            <li><a href="/feed.xml">Blog RSS</a></li>
            <li><a href="/notes/feed.xml">Notes RSS</a></li>
            <li><a href="https://bitbytebit.substack.com/">Subscribe by email</a></li>
            <li><a href="https://bsky.app/profile/zarar.dev">Bluesky</a></li>
            <li><a href={`mailto:${EMAIL}`}>Email</a></li>
          </ul>
        )}
      </div>
    </footer>
  </body>
</html>
