---
import Base from "../layouts/Base.astro";
---

<Base sidebar={false}>
    <h1 class="visually-hidden">Zarar Siddiqi</h1>
    <div class="home">
        <section>
            <h2>
                Build things <strong>people love</strong>
            </h2>
            <p>
                I like to create software that makes people happy. It's usually
                because it's fast, simple to use, and solves their problem. If
                you like working with someone invested in your success, get in
                touch.
            </p>
            <a class="btn" href="/services/">
                Let's Start
            </a>
        </section>
        <section>
            <h2>
                Ideas, opinions <strong>and rants</strong>
            </h2>
            <p>
                I mainly write for two reasons: 1) share things I've learned, 2)
                help me figure out what I actually think. I find writing to be
                cathartic while bringing clarity.
            </p>
            <a class="btn" href="/blog/">
                Bloggity Blog
            </a>
        </section>
    </div>
</Base>
