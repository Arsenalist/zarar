---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { EMAIL, fmtDate } from '../../site';

export async function getStaticPaths() {
  return (await getCollection('proposals')).map((proposal) => ({ params: { slug: proposal.id }, props: { proposal } }));
}
const { proposal } = Astro.props;
const { title, client, date, validUntil } = proposal.data;
const { Content } = await render(proposal);
const subject = encodeURIComponent(`Accepting: ${title}`);
---
<Base title={title} noindex>
  <h1 class="star">{title}</h1>
  <p class="proposal-meta">
    <span>Prepared for {client}</span>
    <span>{fmtDate(date)}</span>
    <span>Valid until {fmtDate(validUntil)}</span>
  </p>
  <div class="prose"><Content /></div>
  <section class="proposal-accept">
    <h2 class="star">Ready to <strong>go?</strong></h2>
    <p>Reply to accept, or with any questions. I'll send the agreement and first invoice.</p>
    <a class="btn" href={`mailto:${EMAIL}?subject=${subject}`}>Accept by email</a>
  </section>
</Base>
